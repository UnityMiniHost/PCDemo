{
  "name": "webglhost-runtime-app",
  "version": "1.0.4",
  "description": "PC Runtime App Demo - Command line WebGL game host application",
  "main": "src/index.js",
  "bin": {
    "webglhost-runtime-app-demo": "./bin/webglhost-runtime-app-demo"
  },
  "scripts": {
    "start": "electron src/index.js --config config/development.json --log-file logs/app.log",
    "dev": "cross-env NODE_ENV=development electron src/index.js --config config/development.json --log-file logs/app-dev.log",
    "build": "node scripts/build.js",
    "install:sdk": "npm install ../../SDK/webglhost-sdk.tgz ../../SDK/webglhost-runtime-pc.tgz --no-save --force --legacy-peer-deps",
    "prebuild:windows": "npm install --include=dev",
    "build:windows": "cross-env NODE_ENV=production node scripts/build.js --platform win32 && node scripts/package-windows.js",
    "build:windows-debug": "cross-env NODE_ENV=development node scripts/build.js --platform win32 && node scripts/package-windows.js",
    "prebuild:mac": "npm install --include=dev",
    "build:mac": "cross-env NODE_ENV=production node scripts/build.js --platform darwin && node scripts/package-mac.js",
    "build:mac-debug": "cross-env NODE_ENV=development node scripts/build.js --platform darwin && node scripts/package-mac.js",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:obfuscation": "node scripts/test-obfuscation.js",
    "verify:build": "node scripts/verify.js",
    "test:local": "cross-env NODE_ENV=production electron src/index.js --config config/local-test.json",
    "test:two-local": "cross-env NODE_ENV=development electron src/index.js --config config/local-two.json --log-file logs/local-two-dev.log",
    "test:local-script": "cross-env NODE_ENV=production electron scripts/test-local.js",
    "test:local-direct": "cross-env NODE_ENV=production electron src/index.js --game-id local-demo --launch-key local-demo --sdk-key test-key --sdk-secret test-secret --user-id test-user --debug --log-level debug",
    "test:game1": "cross-env electron src/index.js --launch-key 67ff545e00378e2bc3aced08 --access-token nK9srsLBeOYJYVoWqe5oTu9WGBp1SufpMJDiFUQw-gY01ef  --log-file logs/app-game1.log",
    "test:game2": "cross-env electron src/index.js --launch-key 687897ebbb916a55f1ac024d --access-token nK9srsLBeOYJYVoWqe5oTu9WGBp1SufpMJDiFUQw-gY01ef  --log-file logs/app-game2.log",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "clean": "node scripts/clean.js",
    "clean:all": "npm run clean && node scripts/obfuscate.js --clean",
    "link:runtime": "npm link ../webglhost-runtime",
    "unlink:runtime": "npm unlink webglhost-runtime"
  },
  "keywords": [
    "webgl",
    "game",
    "runtime",
    "host",
    "command-line",
    "cli"
  ],
  "author": "UnityMiniHost",
  "license": "MIT",
  "dependencies": {
    "@webglhost/sdk": "file:../../SDK/webglhost-sdk.tgz",
    "axios": "^1.11.0",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "cross-env": "^7.0.3",
    "form-data": "^4.0.0",
    "fs-extra": "^11.1.1",
    "inquirer": "^9.2.12",
    "ora": "^7.0.1",
    "os": "^0.1.2",
    "path": "^0.12.7",
    "webglhost-runtime-pc": "file:../../SDK/webglhost-runtime-pc.tgz",
    "winston": "^3.11.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "electron": "^36.2.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.56.0",
    "javascript-obfuscator": "^4.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.10",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "build": {
    "appId": "com.webglhost.runtime-app-demo",
    "productName": "WebGLHostRuntimeApp",
    "copyright": "Copyright © 2025 UnityMiniHost",
    "icon": "assets/unitylogo.png",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asarUnpack": [
      "node_modules/classic-level/**/*",
      "node_modules/electron/**/*"
    ],
    "files": [
      "src/**/*",
      "bin/**/*",
      "config/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json",
      "!logs",
      "!test",
      "!*.md",
      "!.git",
      "!src-backup",
      "!scripts/obfuscate.js",
      "!src-original",
      "!src-temp-backup",
      "!customScripts",
      "!src-obfuscated",
      "!temp-build-src"
    ],
    "extraResources": [],
    "extraFiles": [
      {
        "from": "src/version.json",
        "to": "version.json"
      },
      {
        "from": "customScripts",
        "to": "customScripts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extraFiles": [
        {
          "from": "src/version.json",
          "to": "Contents/version.json"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WebGLHost Runtime App Demo",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "menuCategory": "Games",
      "artifactName": "WebGLHost-Runtime-App-Demo-Setup-${version}.${ext}",
      "perMachine": true,
      "packElevateHelper": true,
      "removeDefaultUninstallWelcomePage": false,
      "guid": "cn.tuanjie.minihost.runtime-app-demo"
    },
    "dmg": {
      "title": "WebGLHost Runtime App Demo",
      "backgroundColor": "#ffffff",
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}